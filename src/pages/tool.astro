---
/**
 * QueryDrop — Tool Page (Stage 4)
 * Loads DuckDB-WASM on mount, handles file drop, previews first 100 rows.
 * Full SQL editor lands in Stage 6.
 */
import Layout from '../layouts/Layout.astro';
import { QueryPad } from '../components/tool/QueryPad';
---

<Layout
  title="Open the tool — QueryDrop"
  description="SQL analytics on your local files. 100% in your browser."
  noindex={true}
>
  <div class="min-h-screen flex flex-col">
    <!-- Top bar -->
    <header class="border-b border-border-subtle bg-bg-0">
      <div class="px-4 sm:px-6 h-12 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-text-primary hover:no-underline">
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#0a0a0f" stroke="#00f0ff" stroke-width="1.5"/>
            <path d="M8 10h16M8 16h12M8 22h8" stroke="#00f0ff" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <span class="font-semibold text-sm">QueryDrop</span>
          <span class="hidden sm:inline text-text-tertiary text-xs mono ml-2">/tool</span>
        </a>
      </div>
    </header>

    <QueryPad client:only="react" />
  </div>
</Layout>

